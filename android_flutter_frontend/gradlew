#!/usr/bin/env bash
# Wrapper shim to build the Android project from the repository root for CI/tools.
set -euo pipefail

# Resolve repo root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANDROID_DIR="smart-personal-assistant-178449-178459/android_flutter_frontend"

if [ ! -d "$SCRIPT_DIR/$ANDROID_DIR" ]; then
  echo "Android project directory not found at $ANDROID_DIR" >&2
  exit 1
fi

cd "$SCRIPT_DIR/$ANDROID_DIR"
exec ./gradlew "$@"
