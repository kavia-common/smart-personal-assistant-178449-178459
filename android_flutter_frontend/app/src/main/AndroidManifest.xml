<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.example.app">

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Media/gallery access (SDK-aware: requested at runtime as needed).
         On Android 13+ uses READ_MEDIA_IMAGES; on older versions uses READ_EXTERNAL_STORAGE. -->
    <!-- Android 13+ granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:targetApi="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:targetApi="33" />
    <!-- Pre-33 legacy external storage read (gated in code for < 33) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Optional: SMS read permission (only if user explicitly consents inside app).
         If you publish to Play without SMS features, remove via tools:node or product flavors:
         <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" />
    -->
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="merge" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:theme="@style/Theme.OceanProfessional">

        <!-- Remove WorkManager's default initializer since App provides Configuration.Provider -->
        <meta-data
            android:name="androidx.work.impl.WorkManagerInitializer"
            android:value="disabled" />

        <!-- Remove the AndroidX Startup provider used by WorkManager -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
