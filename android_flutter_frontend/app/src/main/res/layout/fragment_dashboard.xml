<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:tag="test:dashboard_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:text="@string/title_dashboard"
            android:contentDescription="@string/title_dashboard"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/op_text"
            android:accessibilityHeading="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/dashboard_welcome"
                android:contentDescription="@string/dashboard_welcome"
                android:textColor="@color/op_text" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions hint card to help users discover the Permissions Center -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_permissions_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/dashboard_permissions_hint_help">

            <TextView
                android:id="@+id/permissions_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/dashboard_permissions_hint"
                android:contentDescription="@string/dashboard_permissions_hint"
                android:importantForAccessibility="yes"
                android:tag="test:permissions_hint_text"
                android:textColor="@color/op_text" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
