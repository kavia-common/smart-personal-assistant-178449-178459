<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_permissions_center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:padding="12dp"
    android:background="@color/op_surface"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/row_permissions_center_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/title_permissions_center"
        android:textColor="@color/op_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_permissions_center_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/op_text" />
</LinearLayout>
