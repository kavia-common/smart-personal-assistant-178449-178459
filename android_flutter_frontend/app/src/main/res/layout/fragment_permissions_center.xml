<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="test:permissions_center_root"
    android:background="@color/op_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/permissions_title"
            android:text="@string/title_permissions_center"
            android:contentDescription="@string/title_permissions_center"
            android:textStyle="bold"
            android:textColor="@color/op_text"
            android:textSize="20sp"
            android:accessibilityHeading="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/permissions_desc"
            android:text="@string/desc_permissions_center"
            android:layout_marginTop="4dp"
            android:textColor="@color/op_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Location Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/perm_location"
                    android:textStyle="bold"
                    android:textColor="@color/op_text"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/location_status"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/perm_location"
                    android:accessibilityLiveRegion="polite"/>

                <TextView
                    android:id="@+id/location_subtitle"
                    android:layout_marginTop="2dp"
                    android:text="@string/summary_permission_location_short"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/location_rationale"
                    android:layout_marginTop="6dp"
                    android:text="@string/rationale_location"
                    android:contentDescription="@string/rationale_location"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/location_action"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_manage"
                    android:contentDescription="@string/cd_btn_manage_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Media Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/perm_media"
                    android:textStyle="bold"
                    android:textColor="@color/op_text"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/media_status"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/perm_media"
                    android:accessibilityLiveRegion="polite"/>

                <TextView
                    android:id="@+id/media_subtitle"
                    android:layout_marginTop="2dp"
                    android:text="@string/summary_permission_media_short"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/media_rationale"
                    android:layout_marginTop="6dp"
                    android:text="@string/rationale_media_t"
                    android:contentDescription="@string/rationale_media_t"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/media_action"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_manage"
                    android:contentDescription="@string/cd_btn_manage_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SMS Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

        <!-- Tip -->
        <TextView
            android:id="@+id/permissions_tip_denied_permanently"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/op_text"
            android:text="@string/permissions_tip_denied_permanently"/>

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/perm_sms"
                    android:textStyle="bold"
                    android:textColor="@color/op_text"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/sms_status"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"/>

                <TextView
                    android:id="@+id/sms_rationale"
                    android:layout_marginTop="6dp"
                    android:text="@string/rationale_sms_optional"
                    android:textColor="@color/op_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:text="@string/label_opt_in"
                        android:textColor="@color/op_text"
                        android:layout_gravity="center_vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <Switch
                        android:id="@+id/sms_opt_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sms_action"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_manage"
                    android:contentDescription="@string/cd_btn_manage_sms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
